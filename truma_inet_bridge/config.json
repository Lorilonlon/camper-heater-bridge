{
  "name": "Camper Heater Bridge",
  "version": "0.1.8",
  "slug": "truma_inet_bridge",
  "description": "Lokale Bluetooth-Brücke für die klassische Truma iNet-Box, mit Kopplung und MQTT.",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "host_dbus": true,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:rv-truck",
  "panel_title": "Truma Einrichtung",
  "options": {
    "adapter": "hci0",
    "box_address": "",
    "allow_control": false,
    "poll_seconds": 15,
    "mqtt_host": "",
    "mqtt_port": 8883,
    "mqtt_username": "",
    "mqtt_password": "",
    "mqtt_tls": true,
    "mqtt_ca": "",
    "mqtt_insecure": false
  },
  "schema": {
    "adapter": "match(^hci[0-9]+$)",
    "box_address": "match(^$|^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$)",
    "allow_control": "bool",
    "poll_seconds": "int(5,120)",
    "mqtt_host": "str",
    "mqtt_port": "port",
    "mqtt_username": "str",
    "mqtt_password": "password",
    "mqtt_tls": "bool",
    "mqtt_ca": "str",
    "mqtt_insecure": "bool"
  },
  "stage": "experimental",
  "url": "https://github.com/Lorilonlon/camper-heater-bridge"
}
